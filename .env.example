# Exemplo de configuração - Copie para .env e altere os valores

# Banco de Dados
POSTGRES_USER=admin
POSTGRES_PASSWORD=senha_exemplo
POSTGRES_DB=gestao_ac
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend - FastAPI
# No Docker, o HOST deve ser 'db'. Localmente, use 'localhost'.
DATABASE_URL=postgresql://admin:senha_exemplo@db:5432/gestao_ac